{
  "$schema": "../src/PageWalkerLocal/appsettings.schema.json",
  "modelsRoot": "models",
  "targetMode": "ActiveWindow",
  "targetProcessNames": [ "chrome", "msedge", "SunBrowser", "AdsPower Global" ],
  "rectangle": { "x": 0, "y": 0, "width": 1280, "height": 720 },
  "dryRun": true,
  "behaviorProfile": "normal",
  "randomSeed": 12345,
  "maxDepth": 2,
  "maxSteps": 120,
  "maxScrollsPerPage": 10,
  "maxRuntimeSeconds": 300,
  "allowExternalNavigation": false,
  "allowedDomains": [],
  "blockedTexts": [ "payment", "deposit", "buy now", "subscribe", "confirm payment" ],
  "allowAgeGate": true,
  "allowSimpleConfirmations": true,
  "allowAcceptButtons": false,
  "allowedGateTexts": [ "I am 18", "I am over 18", "Yes, I am 18+", "Continue", "Enter" ],
  "allowForms": false,
  "allowedFormFields": [ "email", "name" ],
  "testFormData": {
    "email": "test@example.invalid",
    "name": "Test User"
  },
  "closeOwnTabsOnFinish": true,
  "technicalPageAction": "retry",
  "retryCount": 2,
  "retryDelayMs": 3000,
  "ocr": {
    "enabled": true,
    "engine": "RapidOCR",
    "modelsPath": "auto"
  },
  "localBrain": {
    "enabled": false,
    "provider": "LLamaSharp",
    "modelPath": "auto",
    "maxTokens": 160,
    "temperature": 0.2,
    "strictJson": true,
    "minConfidence": 0.65
  },
  "logging": {
    "level": "Information",
    "saveScreenshots": true,
    "saveDecisionJson": true
  }
}
