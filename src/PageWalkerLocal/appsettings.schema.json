{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PageWalkerLocal settings",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "modelsRoot": { "type": "string", "default": "models" },
    "targetMode": { "enum": [ "ActiveWindow", "Rectangle" ] },
    "targetProcessNames": { "type": "array", "items": { "type": "string" } },
    "rectangle": {
      "type": "object",
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "required": [ "x", "y", "width", "height" ]
    },
    "dryRun": { "type": "boolean", "default": true },
    "behaviorProfile": { "enum": [ "cautious", "normal", "fast", "load-test" ] },
    "randomSeed": { "type": [ "integer", "null" ] },
    "maxDepth": { "type": "integer", "minimum": 0 },
    "maxSteps": { "type": "integer", "minimum": 1 },
    "maxScrollsPerPage": { "type": "integer", "minimum": 0 },
    "maxRuntimeSeconds": { "type": "integer", "minimum": 1 },
    "allowExternalNavigation": { "type": "boolean" },
    "allowedDomains": { "type": "array", "items": { "type": "string" } },
    "blockedTexts": { "type": "array", "items": { "type": "string" } },
    "allowAgeGate": { "type": "boolean" },
    "allowSimpleConfirmations": { "type": "boolean" },
    "allowAcceptButtons": { "type": "boolean" },
    "allowForms": { "type": "boolean" },
    "technicalPageAction": { "enum": [ "stop", "retry", "back", "close_tab" ] },
    "retryCount": { "type": "integer", "minimum": 0 },
    "retryDelayMs": { "type": "integer", "minimum": 0 },
    "ocr": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "engine": { "type": "string", "default": "RapidOCR" },
        "modelsPath": { "type": [ "string", "null" ], "default": "auto" }
      }
    },
    "localBrain": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "provider": { "type": "string", "default": "LLamaSharp" },
        "modelPath": { "type": [ "string", "null" ], "default": "auto" },
        "maxTokens": { "type": "integer", "minimum": 1 },
        "temperature": { "type": "number", "minimum": 0 },
        "strictJson": { "type": "boolean" },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": { "type": "string" },
        "saveScreenshots": { "type": "boolean" },
        "saveDecisionJson": { "type": "boolean" }
      }
    }
  }
}
